# ==========================================
# Nexora AI - Git Ignore
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Environment / Secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.example.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Explicit project environment files
backend/.env
backend/.env.*
ai-service/.env
ai-service/.env.*
frontend/.env.local
frontend/.env.*
frontend/.env.production.local

# ------------------------------------------
# Next.js / Frontend
# ------------------------------------------
.next/
out/
.vercel/

# ------------------------------------------
# Production / Build
# ------------------------------------------
build/
dist/

# ------------------------------------------
# TypeScript
# ------------------------------------------
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------
# Testing
# ------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ------------------------------------------
# User Uploaded Files
# NEVER commit resumes, avatars, recordings, etc.
# ------------------------------------------
backend/uploads/

# ------------------------------------------
# Local Database / SQLite
# ------------------------------------------
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Prisma
# ------------------------------------------
# Do NOT ignore Prisma schema/migrations.
# Only ignore local Prisma generated artifacts if needed.
.prisma/

# ------------------------------------------
# IDE / Editors
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------
# macOS
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------
# Certificates / Private Keys
# ------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx

# ------------------------------------------
# Temporary Files
# ------------------------------------------
*.tmp
*.temp
*.bak
*.cache

# ------------------------------------------
# OS / Editor temporary files
# ------------------------------------------
*~