# ==========================================
# NEXORA AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Security & Authentication
JWT_SECRET=nexora_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://nexora_user:nexora_password@localhost:5432/nexora_db?schema=public

# AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini # gemini | fallback

# Third Party Services
GITHUB_PAT=your_github_personal_access_token_here

# Feature Flags
ENABLE_AI=true
ENABLE_GITHUB_INTELLIGENCE=true
ENABLE_PLACEMENT_INTELLIGENCE=true
ENABLE_RECRUITER=true
