# ===================================================
# NEXORA AI - ENVIRONMENT CONFIGURATION (.env)
# ===================================================

# ---------------------------------------------------
# 1. REQUIRED SYSTEM CONFIGURATION
# ---------------------------------------------------
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL=postgresql://nexora_user:nexora_password@localhost:5432/nexora_db?schema=public

# Security & Authentication Secrets
JWT_SECRET=nexora_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------
# 2. EMAIL / SMTP CONFIGURATION (Real Email OTP)
# ---------------------------------------------------
# Leave blank to enable Email Simulation Mode in development terminal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Nexora AI Platform <no-reply@nexora.ai>"

# ---------------------------------------------------
# 3. GOOGLE OAUTH 2.0 CONFIGURATION
# ---------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------------------------------------------------
# 4. GITHUB OAUTH 2.0 CONFIGURATION
# ---------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---------------------------------------------------
# 5. LINKEDIN OAUTH / OPENID CONNECT CONFIGURATION
# ---------------------------------------------------
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# ---------------------------------------------------
# 6. AI PROVIDER CONFIGURATION
# ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
AI_PROVIDER=fallback
