// Prisma schema for Nexora AI Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  UNVERIFIED
  SUSPENDED
  DEACTIVATED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  LINKEDIN
}

enum OtpType {
  REGISTRATION
  PASSWORD_RESET
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?        // Nullable for pure OAuth users
  firstName     String
  lastName      String
  name          String?        // Full name computed or set
  emailVerified Boolean        @default(false)
  avatar        String?
  status        UserStatus     @default(UNVERIFIED)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  oauthAccounts OAuthAccount[]
  sessions      Session[]
  profile       UserProfile?
  otpRecords    OtpVerification[]
  resumes       Resume[]
  mentorConversations MentorConversation[]
  codingSubmissions   CodingSubmission[]
  codingProgress      CodingProgress[]
  interviews          Interview[]
  interviewRecordings InterviewRecording[]
  githubAccount       GitHubAccount?
  githubAnalyses      GitHubRepositoryAnalysis[]
  githubSkillEvidences GitHubSkillEvidence[]

  @@index([email])
}

// ===================================================
// AI INTERVIEW STUDIO MODELS (MOCK TEST & LIVE INTERVIEW)
// ===================================================

enum InterviewMode {
  MOCK_TEST
  LIVE_INTERVIEW
}

enum InterviewType {
  HR_BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
  MIXED
  RESUME_BASED
}

enum InterviewStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  TERMINATED_INTEGRITY
}

model Interview {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            InterviewMode   @default(MOCK_TEST)
  type            InterviewType   @default(TECHNICAL)
  targetRole      String          @default("Software Engineer")
  difficulty      Difficulty      @default(MEDIUM)
  durationMinutes Int             @default(30)
  status          InterviewStatus @default(CREATED)

  resumeVersionId String?
  jobDescription  String?         @db.Text

  overallScore          Int?
  communicationScore    Int?
  technicalScore        Int?
  structureScore        Int?
  speechClarityScore    Int?
  roleRelevanceScore    Int?

  createdAt       DateTime        @default(now())
  completedAt     DateTime?

  questions       InterviewQuestion[]
  report          InterviewReport?
  recording       InterviewRecording?
  events          InterviewEvent[]

  @@index([userId])
  @@index([mode])
  @@index([status])
  @@index([createdAt])
}

model InterviewQuestion {
  id                    String            @id @default(uuid())
  interviewId           String
  interview             Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionIndex         Int
  category              String            // Technical, Behavioral, System Design, STAR
  questionText          String            @db.Text
  hints                 String?           @db.Text
  expectedKeyPoints     String[]          @default([])
  timestampStartSeconds Int               @default(0)

  answers               InterviewAnswer[]

  @@index([interviewId])
}

model InterviewAnswer {
  id                   String            @id @default(uuid())
  questionId           String
  question             InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userText             String?           @db.Text
  transcriptText       String?           @db.Text
  audioDurationSeconds Int?              @default(0)
  wpm                  Int?              @default(0)
  fillerWordsCount     Int?              @default(0)
  fillerWordsDetail    Json?             // { "um": 3, "like": 2 }
  languageDistribution Json?             // { "english": 80, "hindi": 20 }
  evaluationScore      Int?
  evaluationFeedback   Json?             // { strengths: [], improvements: [], starAnalysis: {} }
  createdAt            DateTime          @default(now())

  @@index([questionId])
}

model InterviewReport {
  id                     String      @id @default(uuid())
  interviewId            String      @unique
  interview              Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  overallScore           Int         @default(0)
  communicationScore     Int         @default(0)
  technicalScore         Int         @default(0)
  structureScore         Int         @default(0)
  speechClarityScore     Int         @default(0)
  roleRelevanceScore     Int         @default(0)

  observablePresentation Json?       // { faceVisibilityPct, cameraOrientation, gazeShifts, posture, movement }
  speechMetrics          Json?       // { avgWpm, fillerWordsTotal, avgPauseSec, avgAnswerDurationSec }
  languageDistribution   Json?       // { englishPct, hindiPct, mixedPct, feedback }

  strengths              String[]    @default([])
  improvements           String[]    @default([])
  actionableRecommendations Json?   // [{ problem, recommendation }]
  questionEvaluations    Json?       // Detailed question breakdown array

  createdAt              DateTime    @default(now())

  @@index([interviewId])
}

model InterviewRecording {
  id              String      @id @default(uuid())
  interviewId     String      @unique
  interview       Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  storageKey      String
  mimeType        String      @default("video/webm")
  durationSeconds Int         @default(0)
  fileSizeBytes   Int         @default(0)
  status          String      @default("SAVED") // SAVED | DELETED

  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([interviewId])
}

model InterviewEvent {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  eventType   String    // FOCUS_LOST | FULLSCREEN_EXIT | WARNING_ISSUED | SESSION_TERMINATED
  message     String
  timestamp   DateTime  @default(now())

  @@index([interviewId])
}



enum ParsingStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Resume {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String          @default("My Resume")
  currentVersionId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  versions         ResumeVersion[]

  @@index([userId])
}

model ResumeVersion {
  id               String           @id @default(uuid())
  resumeId         String
  resume           Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber    Int
  originalFileName String
  storageKey       String
  mimeType         String           @default("application/pdf")
  fileSize         Int
  extractedText    String?          @db.Text
  extractedData    Json?            // Parsed JSON (personal, skills, education, experience, etc.)
  parsingStatus    ParsingStatus    @default(PENDING)
  parsingError     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  analyses         ResumeAnalysis[]

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
}

model ResumeAnalysis {
  id               String         @id @default(uuid())
  resumeVersionId  String
  resumeVersion    ResumeVersion  @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  
  targetRole       String?
  targetCompany    String?
  jobDescription   String?        @db.Text

  overallScore     Int            @default(0)
  atsScore         Int            @default(0)
  contentScore     Int            @default(0)
  skillsScore      Int            @default(0)
  experienceScore  Int            @default(0)
  educationScore   Int            @default(0)
  projectsScore    Int            @default(0)
  formattingScore  Int            @default(0)
  keywordScore     Int            @default(0)
  summaryScore     Int            @default(0)

  strengths        String[]       @default([])
  weaknesses       String[]       @default([])
  missingKeywords  String[]       @default([])
  missingSkills    String[]       @default([])
  recommendations  String[]       @default([])
  suggestedChanges Json?          // List of { section, current, suggested, reason }

  extractedData    Json?          // Snapshot of extracted resume data at analysis time
  aiProvider       String         @default("gemini")
  aiModel          String         @default("gemini-1.5-flash")
  analysisStatus   AnalysisStatus @default(PENDING)
  errorMessage     String?
  
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([resumeVersionId])
  @@index([createdAt])
  @@index([targetRole])
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model OtpVerification {
  id         String   @id @default(uuid())
  email      String
  otpHash    String
  type       OtpType
  attempts   Int      @default(0)
  maxAttempts Int     @default(5)
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline    String?
  bio         String?
  skills      String[] @default([])
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MentorRole {
  USER
  ASSISTANT
  SYSTEM
}

model MentorConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  MentorMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model MentorMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MentorRole
  content        String             @db.Text
  createdAt      DateTime           @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ===================================================
// CODING ARENA MODELS
// ===================================================

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
}

model CodingProblem {
  id                 String             @id @default(uuid())
  slug               String             @unique
  title              String
  description        String             @db.Text
  source             String             @default("Nexora Original")
  license            String             @default("MIT")
  difficulty         Difficulty         @default(EASY)
  topic              String             // Arrays, Strings, Linked List, Stack, Queue, Binary Tree, BST, Heap, Hashing, Graphs, Recursion, Backtracking, Dynamic Programming, Greedy, Sorting, Searching
  tags               String[]           @default([])
  examples           Json               // Array of { input, output, explanation }
  constraints        String[]           @default([])
  supportedLanguages String[]           @default(["java", "cpp", "python", "javascript", "typescript"])
  starterCode        Json               // Map of language -> starter code string e.g. { "python": "...", "cpp": "..." }
  timeLimitMs        Int                @default(2000)
  memoryLimitMb      Int                @default(256)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  testCases          CodingTestCase[]
  submissions        CodingSubmission[]
  progress           CodingProgress[]

  @@index([topic])
  @@index([difficulty])
  @@index([slug])
}

model CodingTestCase {
  id             String        @id @default(uuid())
  problemId      String
  problem        CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String        @db.Text
  expectedOutput String        @db.Text
  isHidden       Boolean       @default(false)
  explanation    String?       @db.Text
  order          Int           @default(0)

  @@index([problemId])
  @@index([isHidden])
}

model CodingSubmission {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String
  problem       CodingProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language      String
  code          String           @db.Text
  status        SubmissionStatus @default(ACCEPTED)
  testsPassed   Int              @default(0)
  totalTests    Int              @default(0)
  runtimeMs     Int?
  memoryKb      Int?
  stdout        String?          @db.Text
  stderr        String?          @db.Text
  compileOutput String?          @db.Text
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([problemId])
  @@index([userId, problemId])
  @@index([createdAt])
}

model CodingProgress {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String
  problem         CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  isSolved        Boolean       @default(false)
  isAttempted     Boolean       @default(true)
  attemptsCount   Int           @default(1)
  lastSubmittedAt DateTime      @default(now())
  solvedAt        DateTime?

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
  @@index([isSolved])
}

// ===================================================
// GITHUB INTELLIGENCE MODELS
// ===================================================

model GitHubAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId  String
  username      String
  name          String?
  avatarUrl     String?
  profileUrl    String?
  bio           String?
  publicRepos   Int      @default(0)
  followers     Int      @default(0)
  following     Int      @default(0)
  accessToken   String?  // Secured server-side token if connected via OAuth/PAT
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repositories   GitHubRepository[]
  skillEvidences GitHubSkillEvidence[]

  @@index([username])
}

model GitHubRepository {
  id              String   @id @default(uuid())
  githubAccountId String
  githubAccount   GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  userId          String
  githubRepoId    String
  owner           String
  name            String
  fullName        String
  description     String?  @db.Text
  url             String
  primaryLanguage String?
  languages       Json?    // Language byte mapping { "TypeScript": 10240, "CSS": 3400 }
  stars           Int      @default(0)
  forks           Int      @default(0)
  isPrivate       Boolean  @default(false)
  defaultBranch   String   @default("main")
  pushedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  analyses        GitHubRepositoryAnalysis[]
  skillEvidences  GitHubSkillEvidence[]

  @@unique([githubAccountId, githubRepoId])
  @@index([userId])
  @@index([owner, name])
}

model GitHubRepositoryAnalysis {
  id                 String   @id @default(uuid())
  repositoryId       String
  repository         GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String   @default("COMPLETED") // PENDING | ANALYZING | COMPLETED | FAILED
  analyzedAt         DateTime @default(now())
  projectSummary     String?  @db.Text
  architectureSummary String? @db.Text
  detectedStack      String[] @default([])
  engineeringAreas   String[] @default([])
  engineeringSignals Json?    // README presence/length, test framework, CI/CD, Docker, linting, env config
  activitySignals    Json?    // Commits, active periods, maintenance
  aiReview           Json?    // Maintainability, organization, documentation, testing, duplication, error handling
  resumeBullets      String[] @default([])
  interviewQuestions Json?    // Technical and system design interview questions derived from repo stack
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([repositoryId])
  @@index([userId])
  @@index([status])
}

model GitHubSkillEvidence {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubAccountId String?
  githubAccount   GitHubAccount? @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  repositoryId    String?
  repository      GitHubRepository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  skill           String
  category        String         // Frontend, Backend, Languages, Database, Cloud/DevOps, AI/ML
  evidenceLevel   String         // STRONG | MODERATE | LIMITED | DETECTED | INSUFFICIENT
  evidenceDetails String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([skill])
  @@index([evidenceLevel])
}



